{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitemagic:schema:site-spec:1.0.0",
  "title": "VRE-safe Site Magic SiteSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "siteId", "tenantId", "tenantMode", "factSnapshotHash", "sections"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "siteId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "tenantId": {"enum": ["demo-hvac-a", "demo-hvac-b"]},
    "tenantMode": {"const": "synthetic-demo"},
    "factSnapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "designVariant": {"enum": ["workshop-contrast", "field-notebook", "after-hours"]},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "sectionType", "content", "claims"],
        "properties": {
          "sectionId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "sectionType": {"enum": ["navigation", "hero", "trust", "services", "proof", "contact", "footer"]},
          "compositionVariant": {"type": ["string", "null"]},
          "content": {"type": "object"},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claimId", "status", "text"],
              "properties": {
                "claimId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
                "status": {"enum": ["supported", "omitted", "needs_proof"]},
                "text": {"type": "string"},
                "factIds": {"type": "array", "items": {"type": "string"}},
                "reason": {"type": ["string", "null"]}
              },
              "allOf": [
                {"if": {"properties": {"status": {"const": "supported"}}, "required": ["status"]}, "then": {"required": ["factIds"], "properties": {"factIds": {"minItems": 1}}}},
                {"if": {"properties": {"status": {"enum": ["omitted", "needs_proof"]}}, "required": ["status"]}, "then": {"properties": {"factIds": {"maxItems": 0}}}}
              ]
            }
          }
        }
      }
    }
  }
}
