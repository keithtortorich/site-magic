# VRE-safe private demo settings. Never add production credentials here.

# Local open-source model endpoint: Ollama, llama.cpp server, or vLLM.
SITE_MAGIC_USE_AI_COMPATIBLE=true
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1:8b

# Avoid any hosted image provider in the synthetic demo.
SITE_MAGIC_USE_SYNTHETIC_ASSETS=true

# Seal bundles to a private local directory instead of hosted object storage.
SITE_MAGIC_USE_LOCAL_ARTIFACTS=true
SITE_MAGIC_LOCAL_ARTIFACT_DIR=./artifacts/runtime

# Local control-plane callback settings only.
SITE_MAGIC_API_BASE_URL=http://127.0.0.1:8000
SITE_MAGIC_INTERNAL_API_KEY=local-demo-only
